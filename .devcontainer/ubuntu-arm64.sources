# arm64 пакети (для крос-компіляції під RPi4/ROCK 5B/Jetson) є лише на
# ports.ubuntu.com, а не на archive.ubuntu.com. Architectures: arm64
# обмежує це дзеркало лише arm64, щоб воно не заважало amd64-джерелам.
Types: deb
URIs: http://ports.ubuntu.com/ubuntu-ports/
Suites: noble noble-updates noble-backports noble-security
Components: main restricted universe multiverse
Architectures: arm64
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg
